# Here4Help Main .htaccess Configuration for cPanel
# Apache 2.4+ Configuration - 修復版本

# 啟用重寫引擎
RewriteEngine On

# 安全標頭設置
<IfModule mod_headers.c>
    # 防止 MIME 類型嗅探
    Header always set X-Content-Type-Options nosniff
    
    # 防止點擊劫持
    Header always set X-Frame-Options DENY
    
    # XSS 保護
    Header always set X-XSS-Protection "1; mode=block"
    
    # CORS 標頭
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
    
    # 處理 OPTIONS 預檢請求
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]
</IfModule>

# =============================================================================
# API 路由配置 - 修復後端 API 訪問問題
# =============================================================================

# 1. 直接訪問 backend/api/ 路徑的檔案 (優先處理)
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# 2. Admin API 動態路由 - 處理 /backend/api/admin/users/{id}/action 格式
RewriteRule ^backend/api/admin/users/([0-9]+)/verification$ backend/api/admin/users/verification.php [L,QSA]
RewriteRule ^backend/api/admin/users/([0-9]+)/referral-info$ backend/api/admin/users/referral-info.php [L,QSA]
RewriteRule ^backend/api/admin/users/([0-9]+)/review$ backend/api/admin/users/review.php [L,QSA]

# 3. 通用 API 路由重寫 - 處理 /backend/api/ 請求
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^backend/api/(.*)$ backend/api/$1.php [L,QSA]

# 4. 簡化的 API 路由 - 處理 /api/ 請求（向後兼容）
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ backend/api/$1.php [L,QSA]

# =============================================================================
# 管理後台路由 (Vue.js SPA + Laravel API)
# =============================================================================

# 1. 管理後台前端 (Vue.js SPA) - 路由到 /admin/frontend/
RewriteCond %{REQUEST_URI} ^/admin$
RewriteRule ^admin$ admin/frontend/ [L,R=301]

RewriteCond %{REQUEST_URI} ^/admin/$
RewriteRule ^admin/$ admin/frontend/ [L,R=301]

# 2. 管理後台前端靜態檔案
RewriteCond %{REQUEST_URI} ^/admin/frontend/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# 3. 管理後台前端 SPA 路由 (所有 /admin/frontend/ 請求都指向 index.html)
RewriteCond %{REQUEST_URI} ^/admin/frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/frontend/(.*)$ admin/frontend/index.html [L]

# 4. Laravel 後端 API 路由
RewriteCond %{REQUEST_URI} ^/admin/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/api/(.*)$ admin/public/index.php [L,QSA]

# =============================================================================
# Flutter Web 應用路由
# =============================================================================

# 1. Flutter Web 應用靜態檔案
RewriteCond %{REQUEST_URI} ^/frontend/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# 2. Flutter Web 應用 SPA 路由 (所有 /frontend/ 請求都指向 index.html)
RewriteCond %{REQUEST_URI} ^/frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^frontend/(.*)$ frontend/index.html [L]

# 3. 根路徑重定向到 Flutter Web 應用
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ frontend/ [L,R=301]

# 4. 其他根路徑請求重定向到 Flutter Web 應用
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/socket
RewriteCond %{REQUEST_URI} !^/frontend
RewriteRule ^(.*)$ frontend/index.html [L]

# =============================================================================
# 媒體檔案處理
# =============================================================================
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]
RewriteRule ^backend/uploads/(.*)$ backend/uploads/$1 [L]

# =============================================================================
# PHP 配置
# =============================================================================
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# =============================================================================
# 安全配置
# =============================================================================
# 防止直接訪問敏感檔案
<Files ".env">
    Require all denied
</Files>

<Files "*.log">
    Require all denied
</Files>

<Files "*.sql">
    Require all denied
</Files>

<Files "composer.json">
    Require all denied
</Files>

<Files "composer.lock">
    Require all denied
</Files>

# =============================================================================
# 效能優化
# =============================================================================
# 檔案壓縮
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 瀏覽器快取
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
