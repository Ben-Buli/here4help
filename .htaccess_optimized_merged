# Here4Help Production .htaccess Configuration
# 適用於 public_html 目錄的優化配置
# 支援: Flutter Web + Admin + Backend
# 基於現有配置，添加優化功能

# 啟用重寫引擎
RewriteEngine On

# =============================================================================
# 安全標頭設置
# =============================================================================
<IfModule mod_headers.c>
    # 防止 MIME 類型嗅探
    Header always set X-Content-Type-Options nosniff
    
    # 防止點擊劫持 (保持現有設定)
    Header always set X-Frame-Options DENY
    
    # XSS 保護
    Header always set X-XSS-Protection "1; mode=block"
    
    # HSTS (僅 HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    
    # 內容安全政策 (新增)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://appleid.apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: ws:; frame-src 'self' https://accounts.google.com https://appleid.apple.com;"
    
    # CORS 標頭 (保持現有設定，添加新域名)
    SetEnvIf Origin "^https://hero4help\.demofhs\.com$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://hero4help\.demofhs\.com/web$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://hero4help\.demofhs\.com/admin$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://yourdomain\.com$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://apps\.apple\.com$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://play\.google\.com$" CORS_ALLOW_ORIGIN=$0
    
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Auth-Token, Accept, Origin"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "3600"
    
    # 處理 OPTIONS 預檢請求
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]
</IfModule>

# =============================================================================
# 根目錄重定向 (保持現有設定)
# =============================================================================
# 重定向根目錄到 Flutter Web 應用
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ web/ [L,R=301]

# =============================================================================
# Backend API 路由配置 (保持現有設定)
# =============================================================================
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^backend/api/(.*)$ backend/api/$1.php [L,QSA]

# =============================================================================
# Socket 代理配置 (保持現有設定 - 使用 3001 端口)
# =============================================================================
# WebSocket 代理
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^backend/socket/(.*)$ "ws://localhost:3001/$1" [P,L]

# Socket 伺服器代理
RewriteRule ^backend/socket/(.*)$ http://localhost:3001/$1 [P,L]

# =============================================================================
# Admin 管理員後台路由 (保持現有設定)
# =============================================================================
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ admin/public/$1 [L,QSA]

# =============================================================================
# Flutter Web 應用路由 (保持現有設定)
# =============================================================================
# Flutter Web 靜態檔案
RewriteCond %{REQUEST_URI} ^/web/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# Flutter Web SPA 路由
RewriteCond %{REQUEST_URI} ^/web/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^web/(.*)$ web/index.html [L]

# =============================================================================
# 媒體檔案處理 (保持現有設定)
# =============================================================================
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]
RewriteRule ^backend/uploads/(.*)$ backend/uploads/$1 [L]

# =============================================================================
# 其他請求重定向到 Flutter Web (保持現有設定)
# =============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_URI} !^/web
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/socket
RewriteRule ^(.*)$ web/index.html [L]

# =============================================================================
# PHP 配置 (保持現有設定，添加 PHP8 支援)
# =============================================================================
<IfModule mod_php7.c>
    # 上傳限制
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    
    # 安全設定
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /tmp/php_errors.log
    
    # 時區設定
    php_value date.timezone "Asia/Taipei"
</IfModule>

<IfModule mod_php8.c>
    # 上傳限制
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    
    # 安全設定
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /tmp/php_errors.log
    
    # 時區設定
    php_value date.timezone "Asia/Taipei"
</IfModule>

# =============================================================================
# 效能優化 (新增功能)
# =============================================================================
# 檔案壓縮
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# 瀏覽器快取
<IfModule mod_expires.c>
    ExpiresActive on
    
    # 靜態資源長期快取
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML 短期快取
    ExpiresByType text/html "access plus 1 hour"
    
    # JSON 短期快取
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ETag 設定
<IfModule mod_headers.c>
    # 移除 ETag 以使用快取控制
    Header unset ETag
</IfModule>
FileETag None

# =============================================================================
# 安全防護 (保持現有設定，添加新功能)
# =============================================================================
# 防止目錄瀏覽
Options -Indexes

# 防止 HTTP TRACE 方法
RewriteCond %{REQUEST_METHOD} ^TRACE
RewriteRule .* - [F]

# 防止常見攻擊
RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} ^.*(\[|\]|\(|\)|<|>|ê|"|;|\?|\*|=$).* [NC,OR]
RewriteCond %{QUERY_STRING} ^.*("|'|<|>|\|).* [NC,OR]
RewriteCond %{QUERY_STRING} ^.*(%0|%A|%B|%C|%D|%E|%F|127\.0).* [NC,OR]
RewriteCond %{QUERY_STRING} ^.*(globals|encode|localhost|loopback).* [NC,OR]
RewriteCond %{QUERY_STRING} ^.*(request|select|insert|union|declare).* [NC]
RewriteRule ^(.*)$ - [F,L]

# 防止直接訪問敏感檔案 (擴展檔案類型)
<FilesMatch "\.(env|log|ini|conf|bak|backup|old|tmp|sql|json|lock)$">
    Require all denied
</FilesMatch>

# 防止訪問隱藏檔案
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 防止訪問特定目錄 (新增)
<DirectoryMatch "(^|/)(\.git|\.svn|node_modules|vendor|storage|bootstrap/cache)">
    Require all denied
</DirectoryMatch>

# =============================================================================
# 錯誤頁面 (新增)
# =============================================================================
# 自定義錯誤頁面
ErrorDocument 404 /web/index.html
ErrorDocument 500 /web/index.html

# =============================================================================
# 日誌設定 (新增)
# =============================================================================
# 啟用重寫日誌 (僅在除錯時使用)
