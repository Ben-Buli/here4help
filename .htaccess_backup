# Here4Help Main .htaccess Configuration
# Apache 2.4+ Configuration

# 啟用重寫引擎
RewriteEngine On

# 安全標頭設置
<IfModule mod_headers.c>
    # 防止 MIME 類型嗅探
    Header always set X-Content-Type-Options nosniff
    
    # 防止點擊劫持
    Header always set X-Frame-Options DENY
    
    # XSS 保護
    Header always set X-XSS-Protection "1; mode=block"
    
    # CORS 標頭
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
    
    # 處理 OPTIONS 預檢請求
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]
</IfModule>

# Admin API 動態路由 - 處理 /api/admin/users/{id}/action 格式
RewriteRule ^api/admin/users/([0-9]+)/verification$ backend/api/admin/users/verification.php [L,QSA]
RewriteRule ^api/admin/users/([0-9]+)/referral-info$ backend/api/admin/users/referral-info.php [L,QSA]
RewriteRule ^api/admin/users/([0-9]+)/review$ backend/api/admin/users/review.php [L,QSA]

# 通用 API 路由重寫 - 處理其他 API 請求
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]

# 管理後台路由 (Vue SPA)
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ admin/frontend/dist/$1 [L,QSA]

# Flutter Web 應用路由
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/socket
RewriteRule ^(.*)$ web/index.html [L]

# 媒體檔案處理
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]

# 檔案上傳大小限制
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# 防止直接訪問敏感檔案
<Files ".env">
    Require all denied
</Files>

<Files "*.log">
    Require all denied
</Files>

# 檔案壓縮
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 瀏覽器快取
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
