# direnv 自動載入環境變數
# 需要先安裝 direnv: brew install direnv

# 設定 Flutter 環境變數
export ENVIRONMENT=development

# 設定後端環境變數
export APP_ENV=development

# 設定 Node.js 環境變數
export NODE_ENV=development

# 提示訊息
echo "🌍 環境變數已自動載入"
echo "📱 Flutter 環境: $ENVIRONMENT"
echo "🔧 後端環境: $APP_ENV"
echo "🟢 Node.js 環境: $NODE_ENV"
