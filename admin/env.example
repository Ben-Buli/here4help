# =============================================================================
# Here4Help Admin Laravel Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME="Here4Help Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_URL=http://localhost:8000

# =============================================================================
# DATABASE CONFIGURATION (Shared with Backend)
# =============================================================================
# Use same database as backend for consistency
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hero4helpdemofhs_hero4help
DB_USERNAME=root
DB_PASSWORD=root

# =============================================================================
# CACHE & SESSION CONFIGURATION
# =============================================================================
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_CONNECTION=database

# =============================================================================
# MAIL CONFIGURATION
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@here4help.com
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# ADMIN SPECIFIC CONFIGURATION
# =============================================================================
# Admin Authentication
ADMIN_SESSION_TIMEOUT=3600
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=900

# Admin Security
ADMIN_CSRF_TOKEN_LIFETIME=3600
ADMIN_PASSWORD_MIN_LENGTH=8
ADMIN_REQUIRE_EMAIL_VERIFICATION=true

# Admin File Upload
ADMIN_UPLOAD_MAX_SIZE=5242880
ADMIN_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xlsx

# =============================================================================
# CORS CONFIGURATION (for Admin Frontend)
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# =============================================================================
# BACKEND API INTEGRATION
# =============================================================================
# Backend API URLs for admin operations
BACKEND_API_URL=http://localhost:8888/here4help/backend/api
BACKEND_API_TOKEN=your_backend_admin_api_token_here

# Socket server for real-time updates
SOCKET_SERVER_URL=http://localhost:3001
SOCKET_ADMIN_NAMESPACE=/admin

# =============================================================================
# VITE CONFIGURATION (for Frontend Assets)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${BACKEND_API_URL}"
VITE_SOCKET_URL="${SOCKET_SERVER_URL}"

# =============================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# =============================================================================
# Uncomment and modify for production

# Production App
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://admin.yourdomain.com

# Production Database
# DB_HOST=your_production_host
# DB_PORT=3306
# DB_DATABASE=your_production_database
# DB_USERNAME=your_production_username
# DB_PASSWORD=your_production_password

# Production Cache & Queue
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Production Security
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE_COOKIE=strict
# SANCTUM_STATEFUL_DOMAINS=admin.yourdomain.com

# Production API URLs
# BACKEND_API_URL=https://yourdomain.com/backend/api
# SOCKET_SERVER_URL=https://yourdomain.com:3001
