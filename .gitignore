# =============================================================================
# Here4Help 專案 .gitignore
# 統一環境配置管理 - 安全版本
# =============================================================================

# =============================================================================
# 環境配置檔案 (敏感資訊)
# =============================================================================
# 根目錄環境配置
.env
.env.*
!.env.example
!.envrc

*.env
*.zip
*.tar.gz
*.sql




# Backend 環境配置
backend/.env
backend/.env.*
backend/config/.env
backend/config/.env.*

# Admin 環境配置
admin/.env
admin/.env.*
admin/frontend/.env
admin/frontend/.env.*

# 統一環境配置目錄 (包含敏感資訊)
env/*.env
env/*.env.*

# =============================================================================
# 可以公開的環境配置檔案
# =============================================================================
# Flutter Web 公開配置 (JSON 格式，不含敏感資訊)
!env/flutter_web_*.json
!env/env_loader.php

# Admin Frontend 公開配置
!admin/frontend/.env.local
!admin/frontend/.env.production

# =============================================================================
# 建置產物
# =============================================================================
# Flutter
build/
.dart_tool/
.packages
.pub-cache/
.pub/
pubspec.lock

# Admin Frontend (Vite build output)
admin/public/assets/
admin/frontend/dist/

# Android
android/app/debug
android/app/profile
android/app/release

# iOS
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# Web
web/assets/

# =============================================================================
# 依賴套件
# =============================================================================
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP
vendor/
composer.lock

# =============================================================================
# 日誌檔案
# =============================================================================
*.log
logs/
*.log.*

# =============================================================================
# 系統檔案
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# IDE 設定
# =============================================================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ
.idea/
*.iml
*.ipr
*.iws

# =============================================================================
# 暫存檔案
# =============================================================================
*.tmp
*.temp
*.swp
*.swo
*~

# =============================================================================
# 部署檔案
# =============================================================================
*.tar.gz
*.zip
*.tar
deploy/
deployment/
backend_cpanel_deploy/
admin_cpanel_deploy/
flutter_web_cpanel_deploy/

# =============================================================================
# 測試檔案
# =============================================================================
coverage/
.nyc_output/
test-results/

# =============================================================================
# 備份檔案
# =============================================================================
*.bak
*.backup
*.old
config_backup_*/

# =============================================================================
# 敏感檔案
# =============================================================================
# 私鑰檔案
*.pem
*.key
*.p8
*.p12
private_keys/

# 資料庫備份
*.sql
!schema.sql
!migrations/*.sql

# 憑證檔案
*.crt
*.cer
*.p7b
*.p7c

# =============================================================================
# 專案特定檔案
# =============================================================================
# 環境配置備份
env_config/
env.example.backup

# 部署檢查清單 (不應提交)
*_CHECKLIST.md
*_REPORT.md
!docs/*_REPORT.md
!docs/*_GUIDE.md

# 臨時檔案
temp/
tmp/
cache/

# =============================================================================
# 包含敏感資訊的檔案 (GitHub Push Protection 檢測)
# =============================================================================
# 環境配置相關檔案
PRODUCTION_ENV_FILES.md
PRODUCTION_ENV_SETUP_GUIDE.md
MIGRATION_FROM_APP_ENV.md
GOOGLE_OAUTH_FIX.md

# 部署腳本 (包含敏感資訊)
backend_cpanel_deploy.sh
create_production_env.sh
setup_env.sh
security_check.sh

# 環境配置檔案
backend/config/env.development

# 前端配置檔案 (包含敏感資訊)
frontend/index.html
frontend/js/environment_injector.js

# iOS 配置檔案 (包含敏感資訊)
ios/Runner/GoogleService-Info.plist
ios/Flutter/Debug.secrets.xcconfig
ios/Flutter/Release.secrets.xcconfig

# Android 配置檔案 (包含敏感資訊)
android/app/google-services.json

# 文檔檔案 (包含敏感資訊)
docs/CPanel_部署修復指南.md
docs/CPanel_完整部署指南.md
docs/環境配置整理完成報告.md
docs/優先執行/環境配置整合說明.md
docs/優先執行/第三方登入整合執行步驟.md
docs/archived/deprecated-guides/THIRD_PARTY_AUTH_CONFIG.md