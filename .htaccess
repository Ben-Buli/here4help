# /home/hero4helpdemofhs/public_html/web/.htaccess

# 預設首頁
DirectoryIndex index.html

# 啟用 Rewrite 引擎
RewriteEngine On
RewriteBase /web/

# 允許直接存取存在的檔案或資料夾 (圖片、JS、CSS 等)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 其他所有請求 → index.html (Flutter Web SPA fallback)
RewriteRule ^ index.html [L]

# 禁止目錄瀏覽 (避免洩漏檔案清單)
Options -Indexes

# Flutter Web manifest 與資源允許存取
<FilesMatch "(manifest\.json|FontManifest\.json|AssetManifest\.json)$">
    Require all granted
</FilesMatch>

# 確保 web/assets 下所有檔案可讀
<Directory "/home/hero4helpdemofhs/public_html/web/assets">
    Require all granted
</Directory>

# 保護敏感檔案 (但允許 Flutter 需要的 JSON 檔案)
<FilesMatch "\.(env|sql|log|ini|conf|bak|backup|old|tmp|lock)$">
    Require all denied
</FilesMatch>