# =============================================================================
# Here4Help Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8888/here4help

# =============================================================================
# DATABASE CONFIGURATION (Backend Only - Never expose to frontend)
# =============================================================================
# Development Database
DB_HOST=localhost
DB_PORT=8889
DB_NAME=hero4helpdemofhs_hero4help
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4

# Production Database (for deployment)
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_NAME=your_production_database
PROD_DB_USERNAME=your_production_username
PROD_DB_PASSWORD=your_production_password

# =============================================================================
# JWT CONFIGURATION (Backend Only - Never expose to frontend)
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRY=604800
JWT_ALGORITHM=HS256

# =============================================================================
# OAUTH CONFIGURATION (Backend secrets - Never expose to frontend)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8888/here4help/backend/api/auth/google-callback.php

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here
FACEBOOK_REDIRECT_URI=http://localhost:8888/here4help/backend/api/auth/facebook-callback.php

# Apple OAuth
APPLE_SERVICE_ID=com.example.here4help.login
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_PRIVATE_KEY_PATH=path/to/your/private_key.p8
APPLE_KEY_ID=your_apple_key_id_here
APPLE_REDIRECT_URI=http://localhost:8888/here4help/backend/api/auth/apple-callback.php

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Frontend URLs (comma-separated)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081,http://127.0.0.1:3000

# =============================================================================
# SOCKET.IO SERVER CONFIGURATION
# =============================================================================
SOCKET_PORT=3001
SOCKET_HOST=localhost
SOCKET_URL=http://localhost:3001
SOCKET_TOKEN=default-socket-token
SOCKET_SERVER_URL=http://localhost:3001
SOCKET_SERVER_TOKEN=your-socket-server-token

# =============================================================================
# SERVER PORTS CONFIGURATION
# =============================================================================
# MAMP Web Server (Apache)
WEB_SERVER_PORT=8888
WEB_SERVER_HOST=localhost

# MAMP MySQL Database
DB_PORT=8889

# Laravel Admin Application
ADMIN_APP_PORT=8000
ADMIN_APP_HOST=localhost

# Frontend Development Servers
FRONTEND_DEV_PORT=3000
FRONTEND_WEB_PORT=8080

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=uploads

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Here4Help"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# =============================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# =============================================================================
# Uncomment and modify for production
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com

# Production Database
# PROD_DB_HOST=your_production_host
# PROD_DB_PORT=3306
# PROD_DB_NAME=your_production_database
# PROD_DB_USERNAME=your_production_username
# PROD_DB_PASSWORD=your_production_secure_password

# Production OAuth URIs
# GOOGLE_REDIRECT_URI=https://yourdomain.com/backend/api/auth/google-callback.php
# FACEBOOK_REDIRECT_URI=https://yourdomain.com/backend/api/auth/facebook-callback.php
# APPLE_REDIRECT_URI=https://yourdomain.com/backend/api/auth/apple-callback.php

# Production Socket
# SOCKET_URL=https://yourdomain.com:3001
# SOCKET_SERVER_URL=https://yourdomain.com:3001

# Production Security
# SESSION_SECURE=true
# JWT_SECRET=your_production_jwt_secret_min_64_characters_very_secure
