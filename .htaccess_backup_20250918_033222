# Here4Help Production .htaccess Configuration
# 修正與 production.env 的設定衝突

# 啟用重寫引擎
RewriteEngine On

# =============================================================================
# 安全標頭設置 (與 production.env 一致)
# =============================================================================
<IfModule mod_headers.c>
    # 防止 MIME 類型嗅探
    Header always set X-Content-Type-Options nosniff
    
    # 防止點擊劫持 (與 production.env SESSION_SECURE 一致)
    Header always set X-Frame-Options DENY
    
    # XSS 保護
    Header always set X-XSS-Protection "1; mode=block"
    
    # HSTS (僅 HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    
    # CORS 標頭 (與 production.env CORS_ALLOWED_ORIGINS 一致)
    # 生產環境限制特定域名，而非允許所有來源
    SetEnvIf Origin "^https://hero4help\.demofhs\.com$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://apps\.apple\.com$" CORS_ALLOW_ORIGIN=$0
    SetEnvIf Origin "^https://play\.google\.com$" CORS_ALLOW_ORIGIN=$0
    
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"
    
    # 處理 OPTIONS 預檢請求
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]
</IfModule>

# =============================================================================
# API 路由配置
# =============================================================================

# 1. 直接訪問 backend/api/ 路徑的檔案
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# 2. Admin API 動態路由
RewriteRule ^backend/api/admin/users/([0-9]+)/verification$ backend/api/admin/users/verification.php [L,QSA]
RewriteRule ^backend/api/admin/users/([0-9]+)/referral-info$ backend/api/admin/users/referral-info.php [L,QSA]
RewriteRule ^backend/api/admin/users/([0-9]+)/review$ backend/api/admin/users/review.php [L,QSA]

# 3. 通用 API 路由重寫
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^backend/api/(.*)$ backend/api/$1.php [L,QSA]

# 4. 簡化的 API 路由 (向後兼容)
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ backend/api/$1.php [L,QSA]

# =============================================================================
# 管理後台路由 (Laravel + Vue SPA)
# =============================================================================
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ admin/public/$1 [L,QSA]

# =============================================================================
# Flutter Web 應用路由
# =============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/socket
RewriteRule ^(.*)$ web/index.html [L]

# =============================================================================
# 媒體檔案處理
# =============================================================================
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]
RewriteRule ^backend/uploads/(.*)$ backend/uploads/$1 [L]

# =============================================================================
# PHP 配置 (與 production.env 一致)
# =============================================================================
<IfModule mod_php7.c>
    # 一般上傳限制 (與 UPLOAD_MAX_SIZE=10485760 一致)
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

<IfModule mod_php8.c>
    # 一般上傳限制 (與 UPLOAD_MAX_SIZE=10485760 一致)
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# =============================================================================
# 安全配置 (修正檔案保護設定)
# =============================================================================
# 防止直接訪問敏感檔案，但允許 Backend 載入
<Files ".env">
    # 允許 Backend 載入器訪問
    <RequireAll>
        Require all denied
        # 例外：允許 Backend 載入器訪問
        Require local
    </RequireAll>
</Files>

<Files "*.log">
    Require all denied
</Files>

<Files "*.sql">
    Require all denied
</Files>

<Files "composer.json">
    Require all denied
</Files>

<Files "composer.lock">
    Require all denied
</Files>

# =============================================================================
# 效能優化
# =============================================================================
# 檔案壓縮
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 瀏覽器快取
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# =============================================================================
# 防止常見攻擊
# =============================================================================
# 防止 HTTP TRACE 方法
RewriteCond %{REQUEST_METHOD} ^TRACE
RewriteRule .* - [F]

# 防止目錄瀏覽
Options -Indexes

# 限制請求大小 (與 UPLOAD_MAX_SIZE 一致)
LimitRequestBody 10485760
